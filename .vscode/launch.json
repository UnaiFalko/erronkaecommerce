{
    // Configuraciones para iniciar y depurar la aplicación desde VS Code.
    "version": "0.2.0",
    "configurations": [
        // Abre la tienda en Chrome y arranca antes el servidor PHP.
        {
            "name": "WinaDenda: ejecutar en Chrome",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "http://127.0.0.1:8002",
            "webRoot": "${workspaceFolder}/public",
            "preLaunchTask": "WinaDenda: servidor PHP"
        },
        // Espera una conexión del depurador Xdebug.
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9003
        },
        // Ejecuta el archivo PHP que está abierto.
        {
            "name": "Launch currently open script",
            "type": "php",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "port": 0,
            "runtimeArgs": [
                "-dxdebug.start_with_request=yes"
            ],
            "env": {
                "XDEBUG_MODE": "debug,develop",
                "XDEBUG_CONFIG": "client_port=${port}"
            }
        },
        // Inicia un servidor PHP temporal para depuración.
        {
            "name": "Launch Built-in web server",
            "type": "php",
            "request": "launch",
            "runtimeArgs": [
                "-dxdebug.mode=debug",
                "-dxdebug.start_with_request=yes",
                "-S",
                "localhost:0"
            ],
            "program": "",
            "cwd": "${workspaceRoot}",
            "port": 9003,
            "serverReadyAction": {
                "pattern": "Development Server \\(http://localhost:([0-9]+)\\) started",
                "uriFormat": "http://localhost:%s",
                "action": "openExternally"
            }
        }
    ]
}