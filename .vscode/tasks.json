{
    "version": "2.0.0",
    "tasks": [
        // Arranca el servidor PHP local para abrir la tienda en el navegador.
        {
            "label": "WinaDenda: servidor PHP",
            "type": "process",
            "command": "C:\\xampp\\php\\php.exe",
            "args": [
                "-S",
                "127.0.0.1:8002",
                "-t",
                "public"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "php-server",
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Development Server \\(http://127\\.0\\.0\\.1:8002\\) started",
                    "endsPattern": "Development Server \\(http://127\\.0\\.0\\.1:8002\\) started"
                }
            }
        }
    ]
}